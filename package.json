{
  "name": "koom",
  "private": true,
  "version": "0.0.0",
  "description": "Self-deployable Loom-style screen recorder.",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "prepare": "husky || true",
    "lint": "npm run lint -w web",
    "test": "bash ./scripts/test.sh",
    "test:web": "npm test -w web",
    "web:clean": "npm run clean -w web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "swift:format": "swift format format --in-place --recursive client/Sources",
    "swift:lint": "swift format lint --recursive client/Sources",
    "swift:test": "swift test --package-path client",
    "app:build": "./scripts/build-app.sh",
    "app:codesign": "./scripts/setup-dev-codesign.sh",
    "app:install": "./scripts/install-app.sh",
    "app:run": "./scripts/run.sh",
    "app:run:onboarding": "./scripts/run-onboarding.sh",
    "app:run:prod": "KOOM_DEVICE_CREDENTIALS_FILE=${KOOM_DEVICE_CREDENTIALS_FILE:-$HOME/.config/koom/device-credentials.json} ./scripts/install-app.sh --run",
    "shellcheck": "git ls-files -z '*.sh' '*.bash' | xargs -0 shellcheck",
    "sql:lint": "git ls-files -z 'db/migrations/*.sql' | xargs -0 squawk",
    "r2:setup": "tsx scripts/r2-setup.ts",
    "r2:setup:test": "tsx scripts/r2-setup-test.ts",
    "r2:orphans": "tsx scripts/r2-orphans.ts",
    "doctor": "tsx scripts/doctor.ts --operator",
    "doctor:dev": "tsx scripts/doctor.ts --dev",
    "doctor:all": "tsx scripts/doctor.ts --all",
    "render:sync": "tsx scripts/render-sync.ts",
    "device:token": "tsx scripts/device-token.ts",
    "audio-lab": "tsx scripts/audio-lab/server.ts",
    "audio-lab:seed": "tsx scripts/audio-lab/seed.ts",
    "audio-lab:models": "tsx scripts/audio-lab/setup-models.ts",
    "db:start": "docker compose up -d --wait postgres",
    "db:stop": "docker compose stop postgres",
    "db:status": "docker compose ps postgres",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:reset": "tsx scripts/db.ts reset",
    "db:migration:new": "tsx scripts/db.ts new"
  },
  "engines": {
    "node": ">=24.14.1",
    "npm": ">=11.11.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "squawk-cli": "^2.46.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
